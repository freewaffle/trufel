:upd
    # msg[0] = BETA_UPDSCR
        movk r1, 0  # index
        movk r2, BETA_UPDSCR
        setcont r0, r1, r2

    # sending message
        movk r1, BETA
        int r1, r0

    gotok upd

:boot
    newcont r0

    # msg[0] = BETA_SETBACKBUF
        movk r1, 0  # index
        movk r2, BETA_SETBACKBUF
        setcont r0, r1, r2

    # msg[1] = 1  # enabled
        movk r1, 1  # index
        movk r2, 1
        setcont r0, r1, r2

    # sending message
        movk r1, BETA
        int r1, r0


    # msg[0] = BETA_SETPIXEL
        movk r1, 0  # index
        movk r2, BETA_SETPIXEL
        setcont r0, r1, r2

    # msg[1] = 6  # X
        movk r1, 1  # index
        movk r2, 6
        setcont r0, r1, r2

    # msg[2] = 6  # Y
        movk r1, 2  # index
        movk r2, 6
        setcont r0, r1, r2

    # msg[3] = 8  # orange color
        movk r1, 3  # index
        movk r2, 8
        setcont r0, r1, r2

    # sending message
        movk r1, BETA
        int r1, r0

    gotok upd
